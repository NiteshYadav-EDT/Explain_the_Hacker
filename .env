# ──────────────────────────────────────────────────────
# Explain The Hacker — Environment Variables
# ──────────────────────────────────────────────────────

# Set to 'true' to use the built-in mock response (no real backend needed)
VITE_USE_MOCK=true

# Base URL for the real CyberEDT API (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=https://api.cyberedt.io/v1
